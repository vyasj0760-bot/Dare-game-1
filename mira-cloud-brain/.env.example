# Generate a long random value before deployment. Never commit the real value.
MIRA_API_TOKEN=replace-with-a-long-random-secret

# Free-model routing. Keep the key only in the hosting provider's private env settings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=Mira Companion

# Reserved for a future persistent memory adapter; not used yet.
DATABASE_URL=
